# CI Environment Variables
# Mock values for running tests in GitHub Actions
# These are safe to commit as they're non-functional mock values

# User Service Configuration (Mock)
USER_SERVICE_URL=http://localhost:3001
USER_SERVICE_API_KEY=mock_api_key_for_ci

# LLM Provider API Keys (Mock)
GEMINI_API_KEY=mock_gemini_api_key_ci
OPENROUTER_API_KEY=mock_openrouter_api_key_ci

# Configuration
LLM_TIMEOUT_MS=30000
MAX_BATCH_SIZE=10

# Note: Tests should use mocked HTTP responses and not make real API calls
