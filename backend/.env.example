# AI Text Enhancer Backend - Local Environment Variables
# Copy this to .env.local and fill in your actual values

# =============================================================================
# Supabase Configuration (Required)
# =============================================================================
# Get these from: supabase status (for local) or Supabase Dashboard (for cloud)
# Note: Using APP_ prefix because Supabase Edge Functions don't allow SUPABASE_* variables

# Supabase Service Role Key (KEEP SECRET - server-side only)
# Where: Dashboard → Settings → API → service_role key
# Purpose: Runtime database operations (bypasses RLS)
APP_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (for token verification and signing)
# Where: Dashboard → Settings → API → JWT Settings
# Or: supabase status -o json | grep JWT_SECRET
# Purpose: JWT token verification and signing
APP_SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Bootstrap Secret Key (for creating initial test users)
# Purpose: Protects /admin/bootstrap endpoint
# IMPORTANT: Change this in production!
BOOTSTRAP_SECRET_KEY=your-bootstrap-secret-key-change-in-production

# =============================================================================
# LLM Provider API Keys
# =============================================================================

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# Optional: Local Development
# =============================================================================

# LM Studio for local LLM testing
LM_STUDIO_BASE_URL=http://localhost:1234

# =============================================================================
# Optional: Configuration Overrides
# =============================================================================

# LLM request timeout in milliseconds (default: 30000)
LLM_TIMEOUT_MS=30000

# Maximum number of assistants per batch request (default: 10)
MAX_BATCH_SIZE=10

# Internal Jev result selection (optional defaults)
JEV_MODEL_ID=typesafe/jev-1.13
JEV_TIMEOUT_MS=5000

# =============================================================================
# CI/CD Configuration (Only for GitHub Actions)
# =============================================================================
# These are NOT needed for local development (use supabase login instead)

# Supabase Personal Access Token
# Where: https://app.supabase.com/account/tokens → Generate new token
# Purpose: CLI authentication for automated deployments (GitHub Actions)
# Note: Keep this secret! Used for supabase link/deploy/secrets commands in CI/CD
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# Supabase Project Reference ID
# Where: Project URL in dashboard (e.g., https://app.supabase.com/project/[THIS_IS_IT])
# Purpose: Used by GitHub Actions to link to the correct Supabase project
SUPABASE_PROJECT_ID=your_supabase_project_id_here
