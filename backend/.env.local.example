# Copy to .env.local for Edge Functions. Hosted SUPABASE_URL is runtime-provided.
# Blank optional overrides use backend/src/config/ defaults.
SUPABASE_URL=http://127.0.0.1:54321
APP_SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=

LLM_TIMEOUT_MS=
MAX_BATCH_SIZE=
JEV_MODEL_ID=
JEV_TIMEOUT_MS=
EXPOSE_ERROR_DETAILS=false

# Optional server tracing; content capture is disabled by default.
LANGSMITH_TRACING=false
LANGSMITH_CAPTURE_CONTENT=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
APP_ENV=local
APP_RELEASE=local
LOG_LEVEL=info

# Bootstrap is disabled without an explicit JSON user list and a 32+ character secret.
# Never use the test fixtures or local seed passwords for deployed accounts.
BOOTSTRAP_SECRET_KEY=
ADMIN_BOOTSTRAP_USERS_JSON=

# Planned payment feature only; not required by enhance/me/admin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
