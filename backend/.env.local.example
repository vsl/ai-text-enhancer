# AI Text Enhancer Backend - Local Environment Variables
# Copy this to .env.local and fill in your actual values

# =============================================================================
# Supabase Configuration (Required)
# =============================================================================
# Get these from: supabase status (for local) or Supabase Dashboard (for cloud)
# Note: Using APP_ prefix because Supabase Edge Functions don't allow SUPABASE_* variables

# Supabase Project URL
# Local: http://127.0.0.1:54321 (from: supabase status)
# Production: Auto-provided by Supabase Edge Functions (no need to set manually)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase Service Role Key (KEEP SECRET - server-side only)
# Used for admin operations and bypassing RLS
APP_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase JWT Secret (for token verification)
APP_SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Bootstrap Secret Key (Required by the admin function)
# IMPORTANT: Change this in production!
BOOTSTRAP_SECRET_KEY=your-bootstrap-secret-key-change-in-production

# =============================================================================
# LLM Provider API Keys
# =============================================================================

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# Optional: Local Development
# =============================================================================

# LM Studio for local LLM testing
LM_STUDIO_BASE_URL=http://localhost:1234

# =============================================================================
# Optional: Configuration Overrides
# =============================================================================

# LLM request timeout in milliseconds (default: 30000)
LLM_TIMEOUT_MS=30000

# Maximum number of assistants per batch request (default: 10)
MAX_BATCH_SIZE=10

# Internal Jev result selection (optional defaults)
JEV_MODEL_ID=typesafe/jev-1.13
JEV_TIMEOUT_MS=5000

# Raw OpenRouter debug payload logs require both LOG_LEVEL=debug and LANGSMITH_CAPTURE_CONTENT=true.
# Leave both unset/false in normal operation.
# LOG_LEVEL=debug

# LangSmith tracing is off locally unless explicitly enabled.
# Content capture defaults to false; enable it only for sensitive diagnostics.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=ai-text-enhancer-staging
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# APP_ENV=staging
# APP_RELEASE=local

# Supabase Access Token for CLI (if needed)
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# Supabase Project ID (if needed)
SUPABASE_PROJECT_ID=your_supabase_project_id_here

# Server-side only. Tracing omits raw prompts and outputs unless explicitly enabled.
LANGSMITH_CAPTURE_CONTENT=false
